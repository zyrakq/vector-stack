# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=openobserve

ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD="Complexpass#123"
# === STEP CA CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=5080
VIRTUAL_HOST=openobserve.local

# Step CA SSL certificate domain
LETSENCRYPT_HOST=openobserve.local

# Email for Step CA certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com
#Step CA Trust
STEP_CA_TRUST=true
STEP_CA_TRUST_RESTART=true