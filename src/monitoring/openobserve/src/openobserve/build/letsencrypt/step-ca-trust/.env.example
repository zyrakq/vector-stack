# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=openobserve

ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD="Complexpass#123"
# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=5080
VIRTUAL_HOST=openobserve.example.com

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=openobserve.example.com

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com
#Step CA Trust
STEP_CA_TRUST=true
STEP_CA_TRUST_RESTART=true