# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=vector

IMAGE=timberio/vector:latest-alpine

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

VECTOR_CONFIG_DIR=/etc/vector/configs
VECTOR_DATA=vector-data
VECTOR_DATA_EXTERNAL=false
# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=8080
VIRTUAL_HOST=vector.local

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=vector.local

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com