# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, geoip/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=vector

IMAGE=timberio/vector:latest-alpine

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

VECTOR_CONFIG_DIR=/etc/vector/configs
VECTOR_DATA=vector-data
VECTOR_DATA_EXTERNAL=false
# GeoIP
IMAGE=localhost/vector-geoip-alpine:latest

GEOIP_SOURCE=geolite2-city