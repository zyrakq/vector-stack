# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=filebrowser

IMAGE=filebrowser/filebrowser:latest

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

FILEBROWSER_DATA=filebrowser-data
FILEBROWSER_DATA_EXTERNAL=false